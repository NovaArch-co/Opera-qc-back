# Demo Environment Configuration - Copy this to .env.demo
# General Configuration
NODE_ENV=development
HOST=localhost
PORT=8081
SWAGGER_URL=http://localhost:8083

# Database Configuration - Demo Instance
POSTGRES_DB=opera_qc_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres-demo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres-demo:5432/opera_qc_demo

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8083

# Authentication
JWT_SECRET=your-demo-secret-key
JWT_REFRESH_SECRET=ajwtsecret_refresh_demo
JWT_EXPIRES_IN=1d

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS=1000
COMMON_RATE_LIMIT_MAX_REQUESTS=1000

# File Server
FILE_SERVER_BASE_URL=http://185.243.48.218:4567/

# MinIO Configuration - Demo Instance
MINIO_ENDPOINT=minio-demo
MINIO_ENDPOINT_UTL=http://minio-demo:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioaccesskey
MINIO_SECRET_KEY=miniosecretkey

# Redis Configuration - Demo Instance
REDIS_HOST=redis-demo
REDIS_PORT=6379

# Bull Queue Configuration - Demo Instance
BULL_QUEUE=analyseCalls_demo

# Voice Folder Path
VOICE_FOLDER_PATH=/home/afeai/VOICE-2channel

# Audio Directory
AUDIO_DIR=/home/afeai/conversations