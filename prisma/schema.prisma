generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  name       String?
  password   String
  isVerified Boolean @default(false)
}

model SessionEvent {
  id              Int      @id @default(autoincrement())
  type            String
  sourceChannel   String
  sourceNumber    String
  queue           String
  destChannel     String
  destNumber      String
  date            DateTime
  duration        String
  filename        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
